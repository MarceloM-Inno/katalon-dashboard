# ========================================
# Credenciais do Supabase
# ========================================
# Onde encontrar: Supabase Dashboard → Settings → API
# 
# IMPORTANTE: Para scripts de backend (parser, watcher), use a SERVICE ROLE KEY
# - Ela ignora o Row-Level Security (RLS)
# - Tem todas as permissoes de leitura e escrita
# 
# Nao use a ANON KEY para backend:
# - Ela e limitada pelo RLS
# - Pode falhar ao inserir dados em tabelas sem politicas configuradas

SUPABASE_URL=https://rodqhwzivsnxkfdenirx.supabase.co

# SERVICE ROLE KEY (use esta para scripts)
# Formato comeca com: eyJ... (JWT)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ANON/PUBLISHABLE KEY (apenas para frontend, se necessario)
# Formato comeca com: sb_publishable__...
# SUPABASE_KEY=sb_publishable__...

# ========================================
# Parser Automatizado (Katalon XML - Testes Automatizados)
# ========================================
# Caminho onde o Katalon salva os relatorios JUnit XML
REPORT_PATH=E:\Pipeline-Report

# Nome do projeto para diferenciar dados no banco
# Opcoes: ONEY ou BNPL
PROJECT_NAME=BNPL

# ========================================
# Testes Manuais (CSV)
# ========================================
# Caminho onde o Katalon salva os CSVs de testes manuais
# Este e o caminho da pasta Downloads do usuario que executa o Katalon
MANUAL_REPORT_PATH=C:\Users\mmmorais\Downloads

# Mapeamento de nomes no arquivo para projeto
# 
# Os arquivos CSV tem padrao:
#   - Lista Testes All Projects (Oney Bank) data.csv
#   - Lista Testes All Projects (BNPL) data.csv
# 
# Este JSON mapeia o nome entre parenteses para um codigo no banco:
#   - "Oney Bank" -> "ONEY"
#   - "BNPL" -> "BNPL"
#
# Formato: {"Nome no Arquivo": "Codigo no Banco", ...}
MANUAL_PROJECT_MAP={"Oney Bank": "ONEY", "BNPL": "BNPL"}

# ========================================
# Opcionais (geralmente nao precisam ser alterados)
# ========================================
# Regex para extrair informacoes do nome do arquivo CSV
# Padrao esperado: Lista Testes All Projects (Nome Projeto) YYYY-MM-DDTHH_MM_SS+HHMM.csv
# MANUAL_CSV_PATTERN=Lista Testes All Projects \(([^)]+)\) (\d{4}-\d{2}-\d{2}T\d{2}_\d{2}_\d{2}[+-]\d{4})\.csv
